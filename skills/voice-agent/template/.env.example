# --- Provider selection -------------------------------------------------------
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia          # cartesia | elevenlabs

# --- Session defaults (overridable by CLI flags) ------------------------------
SESSION_LANG=en                # ISO code (en, uk, es, fr, ...) or 'multi'
TURN_MODE=trigger              # trigger (say a word to end turn) | vad (end on pause)
TRIGGER_WORD=                  # empty = per-language default ('over' for English)

# --- OpenAI (LLM_PROVIDER=openai) ---------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=               # empty = OpenAI; else any OpenAI-compatible endpoint
LLM_TEMPERATURE=0.4

# --- Deepgram (STT_PROVIDER=deepgram) -----------------------------------------
DEEPGRAM_API_KEY=

# --- Cartesia (TTS_PROVIDER=cartesia) -----------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=             # empty = built-in multilingual sonic-3 voice
CARTESIA_MODEL=sonic-3

# --- ElevenLabs (TTS_PROVIDER=elevenlabs) -------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
